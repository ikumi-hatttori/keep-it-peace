#: src/Admin/Ui.php:74
msgid "PHP / server"
msgstr "PHP / サーバー"

#: src/Admin/Ui.php:75
msgid "Theme"
msgstr "テーマ"

#: src/Admin/Ui.php:76
msgid "Outside WordPress"
msgstr "WordPress 外"

#: src/Admin/Ui.php:77
msgid "Public surface"
msgstr "外部から見た状態"

#: src/Admin/Ui.php:78
msgid "Dependencies"
msgstr "依存パッケージ"

#: src/Admin/Ui.php:79
msgid "WordPress environment"
msgstr "WordPress 環境"

#: src/Checks/Dependencies/DependencyCheck.php:45
msgid "Vulnerable dependencies"
msgstr "脆弱性のある依存パッケージ"

#: src/Checks/Dependencies/DependencyCheck.php:63
msgid "Reads composer.lock and package-lock.json in themes and registered directories and looks up known vulnerabilities on OSV.dev. Only package names and versions are sent."
msgstr "テーマと登録したディレクトリ内の composer.lock と package-lock.json を読み取り、OSV.dev で既知の脆弱性を調べます。送信されるのはパッケージ名とバージョンだけです。"

#: src/Checks/Dependencies/DependencyCheck.php:92
msgid "Lock file could not be read"
msgstr "ロックファイルを読み取れません"

#: src/Checks/Dependencies/DependencyCheck.php:92
msgid "The file is unreadable, too large or not valid JSON, so its packages were not checked."
msgstr "ファイルが読み取れないか、大きすぎるか、正しい JSON ではないため、パッケージをチェックできませんでした。"

#. translators: %s: error message.
#: src/Checks/Dependencies/DependencyCheck.php:114
msgid "OSV.dev could not be reached: %s. Previous results are kept."
msgstr "OSV.dev に接続できませんでした：%s。以前の結果はそのまま保持されます。"

#: src/Checks/Dependencies/DependencyCheck.php:116
msgid "Dependencies could not be checked"
msgstr "依存パッケージをチェックできませんでした"

#. translators: %d: number of vulnerabilities.
#: src/Checks/Dependencies/DependencyCheck.php:176
msgid "and %d more"
msgstr "ほか %d 件"

#. translators: 1: package, 2: version, 3: command.
#: src/Checks/Dependencies/DependencyCheck.php:185
msgid "Update %1$s to %2$s or later (e.g. %3$s), deploy the result and run the scan again."
msgstr "%1$s を %2$s 以降に更新し（例：%3$s）、反映してから再度スキャンしてください。"

#. translators: 1: package, 2: command.
#: src/Checks/Dependencies/DependencyCheck.php:188
msgid "Update %1$s to a version without these vulnerabilities (e.g. %2$s), or replace it if no fix exists."
msgstr "%1$s をこれらの脆弱性のないバージョンに更新してください（例：%2$s）。修正版がない場合は別のパッケージに置き換えてください。"

#. translators: 1: number, 2: list of vulnerabilities.
#: src/Checks/Dependencies/DependencyCheck.php:192
msgid "%1$d known vulnerability: %2$s"
msgid_plural "%1$d known vulnerabilities: %2$s"
msgstr[0] "既知の脆弱性 %1$d 件：%2$s"

#: src/Checks/Dependencies/DependencyCheck.php:197
msgid "(Development dependency, installed on this server.)"
msgstr "（開発用の依存パッケージですが、このサーバーにインストールされています。）"

#. translators: 1: package, 2: version.
#: src/Checks/Dependencies/DependencyCheck.php:208
msgid "Vulnerable package: %1$s %2$s"
msgstr "脆弱性のあるパッケージ：%1$s %2$s"

#: src/Checks/Dependencies/DependencyCheck.php:246
msgid "Run the scan again later. You can disable this check in the settings."
msgstr "しばらくしてから再度スキャンしてください。このチェックは設定で無効にできます。"

#: src/Checks/Environment/UploadsPhpCheck.php:42
msgid "Executable files in uploads"
msgstr "アップロードフォルダ内の実行可能ファイル"

#: src/Checks/Environment/UploadsPhpCheck.php:60
msgid "Looks for .php, .phtml and other executable files in wp-content/uploads, where only media should be stored."
msgstr "本来メディアだけを置く wp-content/uploads に、.php や .phtml などの実行可能ファイルがないか調べます。"

#: src/Checks/Environment/UploadsPhpCheck.php:101
msgid "Uploads directory could not be read"
msgstr "アップロードフォルダを読み取れません"

#: src/Checks/Environment/UploadsPhpCheck.php:103
msgid "Check the permissions of wp-content/uploads."
msgstr "wp-content/uploads のパーミッションを確認してください。"

#: src/Checks/Environment/UploadsPhpCheck.php:151
msgid "PHP file in uploads"
msgstr "アップロードフォルダ内の PHP ファイル"

#: src/Checks/Environment/UploadsPhpCheck.php:151
msgid "Executable file in uploads"
msgstr "アップロードフォルダ内の実行可能ファイル"

#: src/Checks/Environment/UploadsPhpCheck.php:152
msgid "The uploads directory should only contain media. Executable files here are a common sign of a compromised site or of an insecure upload form."
msgstr "アップロードフォルダにはメディアだけを置くべきです。ここに実行可能ファイルがあるのは、サイトが改ざんされているか、安全でないアップロードフォームがある典型的な兆候です。"

#: src/Checks/Environment/UploadsPhpCheck.php:153
msgid "Inspect the file and delete it if it is not required. Also block PHP execution in uploads with server configuration."
msgstr "ファイルの中身を確認し、不要であれば削除してください。また、サーバーの設定でアップロードフォルダでの PHP の実行をブロックしてください。"

#: src/Checks/Environment/WpConfigCheck.php:38
msgid "WordPress configuration"
msgstr "WordPress の設定"

#: src/Checks/Environment/WpConfigCheck.php:56
msgid "Checks WP_DEBUG, WP_DEBUG_DISPLAY, debug.log, wp-config.php permissions and the built-in file editor."
msgstr "WP_DEBUG、WP_DEBUG_DISPLAY、debug.log、wp-config.php のパーミッション、組み込みのファイルエディターをチェックします。"

#: src/Checks/Environment/WpConfigCheck.php:99
msgid "Debug messages are shown to visitors"
msgstr "デバッグメッセージが訪問者に表示される"

#: src/Checks/Environment/WpConfigCheck.php:99
msgid "WP_DEBUG is on and WP_DEBUG_DISPLAY is not off, so PHP notices and errors appear on pages and reveal file paths."
msgstr "WP_DEBUG がオンで WP_DEBUG_DISPLAY がオフになっていないため、PHP の notice やエラーがページに表示され、ファイルのパスが知られてしまいます。"

#: src/Checks/Environment/WpConfigCheck.php:99
msgid "Set define( 'WP_DEBUG', false ) on production, or at least define( 'WP_DEBUG_DISPLAY', false )."
msgstr "本番環境では define( 'WP_DEBUG', false ) を設定するか、少なくとも define( 'WP_DEBUG_DISPLAY', false ) を設定してください。"

#: src/Checks/Environment/WpConfigCheck.php:101
msgid "WP_DEBUG is enabled"
msgstr "WP_DEBUG が有効"

#: src/Checks/Environment/WpConfigCheck.php:101
msgid "Debug mode is on. It is meant for development and can slow the site and fill the log."
msgstr "デバッグモードがオンになっています。これは開発用の機能で、サイトが遅くなったりログが肥大化したりすることがあります。"

#: src/Checks/Environment/WpConfigCheck.php:101
msgid "Set define( 'WP_DEBUG', false ) on production."
msgstr "本番環境では define( 'WP_DEBUG', false ) を設定してください。"

#: src/Checks/Environment/WpConfigCheck.php:114
msgid "debug.log exists"
msgstr "debug.log が存在する"

#: src/Checks/Environment/WpConfigCheck.php:116
msgid "A debug log is stored inside wp-content, where it may be downloadable. Logs can contain paths, queries and personal data."
msgstr "デバッグログが wp-content 内に保存されており、ダウンロードできる可能性があります。ログにはパス、クエリ、個人情報が含まれることがあります。"

#: src/Checks/Environment/WpConfigCheck.php:117
msgid "A debug log file exists."
msgstr "デバッグログファイルが存在します。"

#: src/Checks/Environment/WpConfigCheck.php:118
msgid "Delete the log when it is no longer needed, and set WP_DEBUG_LOG to a path outside the web root."
msgstr "不要になったログは削除し、WP_DEBUG_LOG には Web ルートの外のパスを設定してください。"

#: src/Checks/Environment/WpConfigCheck.php:131
msgid "Set the permissions to 400 or 440 (600/640 if your host requires write access)."
msgstr "パーミッションを 400 または 440 に設定してください（ホスティング会社が書き込み権限を必要とする場合は 600/640）。"

#. translators: %s: permissions such as 666.
#: src/Checks/Environment/WpConfigCheck.php:134
msgid "wp-config.php has permissions %s. Anyone on the server can change it."
msgstr "wp-config.php のパーミッションは %s です。サーバー上の誰でも変更できます。"

#: src/Checks/Environment/WpConfigCheck.php:135
msgid "wp-config.php is world-writable"
msgstr "wp-config.php が誰でも書き込める状態"

#. translators: %s: permissions such as 644.
#: src/Checks/Environment/WpConfigCheck.php:138
msgid "wp-config.php has permissions %s. On shared servers other accounts may be able to read your database password."
msgstr "wp-config.php のパーミッションは %s です。共用サーバーでは、他のアカウントからデータベースのパスワードを読まれるおそれがあります。"

#: src/Checks/Environment/WpConfigCheck.php:139
msgid "wp-config.php is readable by everyone on the server"
msgstr "wp-config.php がサーバー上の誰でも読める状態"

#: src/Checks/Environment/WpConfigCheck.php:145
msgid "Theme and plugin file editor is enabled"
msgstr "テーマ・プラグインのファイルエディターが有効"

#: src/Checks/Environment/WpConfigCheck.php:145
msgid "Administrators can edit PHP files from the dashboard. A stolen admin account can then run arbitrary code."
msgstr "管理者がダッシュボードから PHP ファイルを編集できます。管理者アカウントが乗っ取られると、任意のコードを実行されるおそれがあります。"

#: src/Checks/Environment/WpConfigCheck.php:145
msgid "Add define( 'DISALLOW_FILE_EDIT', true ); to wp-config.php."
msgstr "wp-config.php に define( 'DISALLOW_FILE_EDIT', true ); を追加してください。"

#: src/Checks/External/AbstractExternalCheck.php:160
msgid "The site could not be reached for the external check"
msgstr "外部チェックのためにサイトに接続できない"

#. translators: %s: error message.
#: src/Checks/External/AbstractExternalCheck.php:162
msgid "The request failed: %s. Previous results of this check are kept until the site can be checked again."
msgstr "リクエストに失敗しました：%s。再びチェックできるようになるまで、このチェックの以前の結果は保持されます。"

#: src/Checks/External/AbstractExternalCheck.php:163
msgid "Some hosts block requests from the server to itself (loopback). If the site works for visitors, ask your host to allow loopback requests or disable this check."
msgstr "ホスティング会社によっては、サーバーから自分自身へのリクエスト（ループバック）をブロックしています。訪問者がサイトを問題なく閲覧できる場合は、ホスティング会社にループバックリクエストの許可を依頼するか、このチェックを無効にしてください。"

#: src/Checks/External/DirectoryListingCheck.php:36
msgid "Directory listing"
msgstr "ディレクトリ一覧表示"

#: src/Checks/External/DirectoryListingCheck.php:45
msgid "Checks whether wp-content/uploads and other directories show a list of their files (\"Index of /\")."
msgstr "wp-content/uploads などのディレクトリで、ファイルの一覧（\"Index of /\"）が表示されないかチェックします。"

#: src/Checks/External/DirectoryListingCheck.php:114
msgid "Directory listing is enabled"
msgstr "ディレクトリ一覧表示が有効"

#: src/Checks/External/DirectoryListingCheck.php:115
msgid "Anyone can see the list of files in this directory, including backups and private uploads."
msgstr "このディレクトリのファイル一覧を誰でも見ることができます。バックアップや非公開のアップロードファイルも含まれます。"

#: src/Checks/External/DirectoryListingCheck.php:116
msgid "Disable directory listings (\"Options -Indexes\" in .htaccess for Apache, \"autoindex off\" for nginx) or ask your host."
msgstr "ディレクトリ一覧表示を無効にしてください（Apache は .htaccess に \"Options -Indexes\"、nginx は \"autoindex off\"）。またはホスティング会社に相談してください。"

#: src/Checks/External/ExposedFilesCheck.php:37
msgid "Exposed sensitive files"
msgstr "公開されている機密ファイル"

#: src/Checks/External/ExposedFilesCheck.php:46
msgid "Checks whether files such as .env, .git, wp-config.php backups, SQL dumps, debug.log and phpinfo pages can be downloaded from the site."
msgstr ".env、.git、wp-config.php のバックアップ、SQL ダンプ、debug.log、phpinfo ページなどのファイルがサイトからダウンロードできないかチェックします。"

#. translators: %s: path.
#: src/Checks/External/ExposedFilesCheck.php:138
msgid "Publicly accessible: %s"
msgstr "公開されているファイル：%s"

#: src/Checks/External/ExposedFilesCheck.php:184
msgid "Delete the file from the public directory, or block access to it in the server configuration. Change any passwords or keys it contains."
msgstr "公開ディレクトリからファイルを削除するか、サーバーの設定でアクセスをブロックしてください。ファイルに含まれるパスワードやキーはすべて変更してください。"

#: src/Checks/External/ExposedFilesCheck.php:187
msgid "An environment file is downloadable. It usually contains database passwords and API keys."
msgstr "環境設定ファイルがダウンロードできます。通常、データベースのパスワードや API キーが含まれています。"

#: src/Checks/External/ExposedFilesCheck.php:189
msgid "Version control data is downloadable. Attackers can rebuild your source code, including configuration and credentials committed in the past."
msgstr "バージョン管理のデータがダウンロードできます。攻撃者はソースコードを復元でき、過去にコミットされた設定や認証情報も知られてしまいます。"

#: src/Checks/External/ExposedFilesCheck.php:189
msgid "Remove the .git/.svn/.hg directory from the public directory or deny access to it, then rotate any credentials found in the repository history."
msgstr "公開ディレクトリから .git/.svn/.hg ディレクトリを削除するかアクセスを拒否し、リポジトリの履歴に含まれる認証情報をすべて変更してください。"

#: src/Checks/External/ExposedFilesCheck.php:191
msgid "A backup of wp-config.php is served as plain text, revealing the database password and security keys."
msgstr "wp-config.php のバックアップがテキストのまま配信されており、データベースのパスワードとセキュリティキーが知られてしまいます。"

#: src/Checks/External/ExposedFilesCheck.php:191
msgid "Delete the backup file, change the database password and regenerate the security keys in wp-config.php."
msgstr "バックアップファイルを削除し、データベースのパスワードを変更して、wp-config.php のセキュリティキーを再生成してください。"

#: src/Checks/External/ExposedFilesCheck.php:193
msgid "A PHP error log is downloadable. Logs reveal file paths, plugin names and sometimes personal data."
msgstr "PHP のエラーログがダウンロードできます。ログからはファイルのパス、プラグイン名、場合によっては個人情報が知られてしまいます。"

#: src/Checks/External/ExposedFilesCheck.php:193
msgid "Delete the log, and write logs outside the public directory (set WP_DEBUG_LOG to a private path)."
msgstr "ログを削除し、ログは公開ディレクトリの外に書き出してください（WP_DEBUG_LOG に非公開のパスを設定）。"

#: src/Checks/External/ExposedFilesCheck.php:195
msgid "A phpinfo() page is public. It shows the PHP version, extensions, paths and environment variables."
msgstr "phpinfo() のページが公開されています。PHP のバージョン、拡張機能、パス、環境変数が表示されます。"

#: src/Checks/External/ExposedFilesCheck.php:195
msgid "Delete the file after use."
msgstr "使い終わったらファイルを削除してください。"

#: src/Checks/External/ExposedFilesCheck.php:197
msgid "A database dump is downloadable. It can contain user accounts, password hashes and customer data."
msgstr "データベースのダンプがダウンロードできます。ユーザーアカウント、パスワードのハッシュ、顧客データが含まれている可能性があります。"

#: src/Checks/External/ExposedFilesCheck.php:197
msgid "Delete the dump immediately, store backups outside the public directory, and treat the data as leaked."
msgstr "ダンプをすぐに削除し、バックアップは公開ディレクトリの外に保存してください。データは漏えいしたものとして扱ってください。"

#: src/Checks/External/ExposedFilesCheck.php:199
msgid "A backup archive is downloadable. It may contain the whole site including wp-config.php."
msgstr "バックアップのアーカイブがダウンロードできます。wp-config.php を含むサイト全体が含まれている可能性があります。"

#: src/Checks/External/ExposedFilesCheck.php:199
msgid "Delete the archive and keep backups outside the public directory."
msgstr "アーカイブを削除し、バックアップは公開ディレクトリの外に保存してください。"

#: src/Checks/External/ExposedFilesCheck.php:201
msgid "A password file is downloadable. Password hashes can be cracked offline."
msgstr "パスワードファイルがダウンロードできます。パスワードのハッシュはオフラインで解読されるおそれがあります。"

#: src/Checks/External/ExposedFilesCheck.php:203
msgid "A dependency lock file is downloadable. It lists exact package versions, which helps attackers find known vulnerabilities."
msgstr "依存パッケージのロックファイルがダウンロードできます。パッケージの正確なバージョンが記載されているため、攻撃者が既知の脆弱性を探す手がかりになります。"

#: src/Checks/External/ExposedFilesCheck.php:203
msgid "Block access to lock files or move them outside the public directory."
msgstr "ロックファイルへのアクセスをブロックするか、公開ディレクトリの外に移動してください。"

#: src/Checks/External/ExposedFilesCheck.php:205
msgid "A .DS_Store file is downloadable. It reveals the names of files in the directory."
msgstr ".DS_Store ファイルがダウンロードできます。ディレクトリ内のファイル名が知られてしまいます。"

#: src/Checks/External/ExposedFilesCheck.php:207
msgid "A file that should not be public can be downloaded."
msgstr "公開すべきでないファイルがダウンロードできます。"

#: src/Checks/External/ExternalTargets.php:32
msgid "Site address"
msgstr "サイトアドレス"

#: src/Checks/External/ExternalTargets.php:37
msgid "WordPress address"
msgstr "WordPress アドレス"

#: src/Checks/External/SecurityHeadersCheck.php:36
msgid "Security headers"
msgstr "セキュリティヘッダー"

#: src/Checks/External/SecurityHeadersCheck.php:45
msgid "Checks HSTS, X-Content-Type-Options, clickjacking protection, Referrer-Policy and Content-Security-Policy, the redirect from HTTP to HTTPS, and whether server, PHP or WordPress versions are revealed."
msgstr "HSTS、X-Content-Type-Options、クリックジャッキング対策、Referrer-Policy、Content-Security-Policy、HTTP から HTTPS へのリダイレクト、およびサーバー・PHP・WordPress のバージョンが公開されていないかをチェックします。"

#: src/Checks/External/SecurityHeadersCheck.php:97
msgid "HTTP is not redirected to HTTPS"
msgstr "HTTP が HTTPS にリダイレクトされない"

#: src/Checks/External/SecurityHeadersCheck.php:98
msgid "The site can be opened over unencrypted http:// without being redirected to https://."
msgstr "暗号化されていない http:// でサイトを開いても、https:// にリダイレクトされません。"

#: src/Checks/External/SecurityHeadersCheck.php:99
msgid "Redirect all http:// requests to https:// with a 301 redirect (hosting panel setting or .htaccess)."
msgstr "すべての http:// のリクエストを 301 リダイレクトで https:// に転送してください（ホスティングの管理画面の設定または .htaccess）。"

#: src/Checks/External/SecurityHeadersCheck.php:157
msgid "Strict-Transport-Security (HSTS) is not set"
msgstr "Strict-Transport-Security（HSTS）が未設定"

#: src/Checks/External/SecurityHeadersCheck.php:157
msgid "Without HSTS, browsers may still try http:// first, which allows downgrade attacks on public Wi-Fi."
msgstr "HSTS がないと、ブラウザーが最初に http:// で接続しようとすることがあり、公衆 Wi-Fi などでダウングレード攻撃を受けるおそれがあります。"

#: src/Checks/External/SecurityHeadersCheck.php:157
msgid "Send \"Strict-Transport-Security: max-age=31536000\" once HTTPS works on all pages and subdomains you use."
msgstr "使用しているすべてのページとサブドメインで HTTPS が動作するようになったら、\"Strict-Transport-Security: max-age=31536000\" を送信してください。"

#: src/Checks/External/SecurityHeadersCheck.php:159
msgid "HSTS max-age is short"
msgstr "HSTS の max-age が短い"

#: src/Checks/External/SecurityHeadersCheck.php:159
msgid "The HSTS max-age is less than 180 days."
msgstr "HSTS の max-age が 180 日未満です。"

#: src/Checks/External/SecurityHeadersCheck.php:159
msgid "Use max-age=31536000 (one year) once the setting is confirmed to work."
msgstr "設定が問題なく動作することを確認したら、max-age=31536000（1 年）を使用してください。"

#: src/Checks/External/SecurityHeadersCheck.php:163
msgid "X-Content-Type-Options is not set"
msgstr "X-Content-Type-Options が未設定"

#: src/Checks/External/SecurityHeadersCheck.php:163
msgid "Browsers may guess the type of uploaded files and run them as scripts."
msgstr "ブラウザーがアップロードされたファイルの種類を推測し、スクリプトとして実行してしまうおそれがあります。"

#: src/Checks/External/SecurityHeadersCheck.php:163
msgid "Send \"X-Content-Type-Options: nosniff\"."
msgstr "\"X-Content-Type-Options: nosniff\" を送信してください。"

#: src/Checks/External/SecurityHeadersCheck.php:166
msgid "Clickjacking protection is not set"
msgstr "クリックジャッキング対策が未設定"

#: src/Checks/External/SecurityHeadersCheck.php:166
msgid "Other sites can show your pages in a frame and trick visitors into clicking buttons."
msgstr "他のサイトがあなたのページをフレーム内に表示し、訪問者をだましてボタンをクリックさせるおそれがあります。"

#: src/Checks/External/SecurityHeadersCheck.php:166
msgid "Send \"X-Frame-Options: SAMEORIGIN\" or a Content-Security-Policy with frame-ancestors 'self'."
msgstr "\"X-Frame-Options: SAMEORIGIN\" または frame-ancestors 'self' を含む Content-Security-Policy を送信してください。"

#: src/Checks/External/SecurityHeadersCheck.php:169
msgid "Referrer-Policy is not set"
msgstr "Referrer-Policy が未設定"

#: src/Checks/External/SecurityHeadersCheck.php:169
msgid "Full URLs, including query strings, may be sent to other sites when visitors follow links."
msgstr "訪問者がリンクをたどったときに、クエリ文字列を含む完全な URL が他のサイトに送信されるおそれがあります。"

#: src/Checks/External/SecurityHeadersCheck.php:169
msgid "Send \"Referrer-Policy: strict-origin-when-cross-origin\"."
msgstr "\"Referrer-Policy: strict-origin-when-cross-origin\" を送信してください。"

#: src/Checks/External/SecurityHeadersCheck.php:172
msgid "Content-Security-Policy is not set"
msgstr "Content-Security-Policy が未設定"

#: src/Checks/External/SecurityHeadersCheck.php:172
msgid "A Content-Security-Policy limits where scripts can be loaded from and reduces the impact of XSS."
msgstr "Content-Security-Policy はスクリプトの読み込み元を制限し、XSS の被害を抑えます。"

#: src/Checks/External/SecurityHeadersCheck.php:172
msgid "Start with a Content-Security-Policy-Report-Only header, check the reports, then enforce it."
msgstr "まず Content-Security-Policy-Report-Only ヘッダーで始め、レポートを確認してから適用してください。"

#. translators: %s: header value.
#: src/Checks/External/SecurityHeadersCheck.php:178
msgid "The Server header is \"%s\". Attackers use versions to pick known exploits."
msgstr "Server ヘッダーが \"%s\" になっています。攻撃者はバージョン情報から既知の攻撃手法を選びます。"

#: src/Checks/External/SecurityHeadersCheck.php:179
msgid "The web server version is revealed"
msgstr "Web サーバーのバージョンが公開されている"

#: src/Checks/External/SecurityHeadersCheck.php:179
msgid "Hide the version (e.g. ServerTokens Prod for Apache, server_tokens off for nginx) or ask your host."
msgstr "バージョンを非表示にしてください（例：Apache は ServerTokens Prod、nginx は server_tokens off）。またはホスティング会社に相談してください。"

#. translators: %s: header value.
#: src/Checks/External/SecurityHeadersCheck.php:184
msgid "The X-Powered-By header is \"%s\"."
msgstr "X-Powered-By ヘッダーが \"%s\" になっています。"

#: src/Checks/External/SecurityHeadersCheck.php:185
msgid "X-Powered-By reveals the PHP version"
msgstr "X-Powered-By で PHP のバージョンが公開されている"

#: src/Checks/External/SecurityHeadersCheck.php:185
msgid "Set expose_php = Off in php.ini (or .user.ini), or remove the header in the server configuration."
msgstr "php.ini（または .user.ini）で expose_php = Off を設定するか、サーバーの設定でこのヘッダーを削除してください。"

#. translators: %s: WordPress version.
#: src/Checks/External/SecurityHeadersCheck.php:189
msgid "The generator meta tag reveals WordPress %s."
msgstr "generator メタタグから WordPress %s であることがわかります。"

#: src/Checks/External/SecurityHeadersCheck.php:190
msgid "The WordPress version is shown in the page source"
msgstr "ページのソースに WordPress のバージョンが表示されている"

#: src/Checks/External/SecurityHeadersCheck.php:190
msgid "Keep WordPress up to date. You can remove the tag with remove_action( 'wp_head', 'wp_generator' )."
msgstr "WordPress を最新の状態に保ってください。このタグは remove_action( 'wp_head', 'wp_generator' ) で削除できます。"

#: src/Checks/External/TlsCheck.php:38
msgid "SSL/TLS certificate"
msgstr "SSL/TLS 証明書"

#: src/Checks/External/TlsCheck.php:47
msgid "Checks that the site uses HTTPS, how many days the certificate is valid, whether it is trusted and matches the host name, and the TLS version."
msgstr "サイトが HTTPS を使用しているか、証明書の残り有効日数、信頼できる証明書かどうか、ホスト名と一致しているか、TLS のバージョンをチェックします。"

#: src/Checks/External/TlsCheck.php:108
msgid "The site address does not use HTTPS"
msgstr "サイトアドレスが HTTPS を使用していない"

#: src/Checks/External/TlsCheck.php:109
msgid "Logins, cookies and form data are sent unencrypted."
msgstr "ログイン情報、Cookie、フォームのデータが暗号化されずに送信されます。"

#: src/Checks/External/TlsCheck.php:110
msgid "Enable a free certificate (e.g. Let's Encrypt) in your hosting panel and change the WordPress and site addresses to https://."
msgstr "ホスティングの管理画面で無料の証明書（例：Let's Encrypt）を有効にし、WordPress アドレスとサイトアドレスを https:// に変更してください。"

#: src/Checks/External/TlsCheck.php:123
msgid "The certificate could not be checked on this server"
msgstr "このサーバーでは証明書をチェックできない"

#: src/Checks/External/TlsCheck.php:124
msgid "stream_socket_client() or the OpenSSL extension is not available to PHP."
msgstr "PHP で stream_socket_client() または OpenSSL 拡張機能が利用できません。"

#: src/Checks/External/TlsCheck.php:125
msgid "Check the certificate expiry date in your hosting panel instead."
msgstr "代わりにホスティングの管理画面で証明書の有効期限を確認してください。"

#: src/Checks/External/TlsCheck.php:138
msgid "Could not connect over HTTPS"
msgstr "HTTPS で接続できない"

#. translators: %s: error message.
#: src/Checks/External/TlsCheck.php:140
msgid "The TLS connection failed: %s"
msgstr "TLS 接続に失敗しました：%s"

#: src/Checks/External/TlsCheck.php:141
msgid "If visitors can open the site over HTTPS, the server may block connections to itself. Otherwise check the certificate in your hosting panel."
msgstr "訪問者が HTTPS でサイトを開ける場合は、サーバーが自分自身への接続をブロックしている可能性があります。開けない場合は、ホスティングの管理画面で証明書を確認してください。"

#. translators: %s: date.
#: src/Checks/External/TlsCheck.php:177
msgid "The certificate expires on %s."
msgstr "証明書の有効期限は %s です。"

#: src/Checks/External/TlsCheck.php:178
msgid "Renew the certificate or check that automatic renewal works in your hosting panel."
msgstr "証明書を更新するか、ホスティングの管理画面で自動更新が機能しているか確認してください。"

#: src/Checks/External/TlsCheck.php:180
msgid "The SSL certificate has expired"
msgstr "SSL 証明書の有効期限切れ"

#: src/Checks/External/TlsCheck.php:180
msgid "Browsers show a security warning to visitors."
msgstr "ブラウザーが訪問者にセキュリティ警告を表示します。"

#. translators: %d: days.
#: src/Checks/External/TlsCheck.php:183
#: src/Checks/External/TlsCheck.php:186
msgid "The SSL certificate expires in %d day"
msgid_plural "The SSL certificate expires in %d days"
msgstr[0] "SSL 証明書の有効期限まであと %d 日"

#. translators: %s: names in the certificate.
#: src/Checks/External/TlsCheck.php:191
msgid "The certificate is issued for: %s"
msgstr "証明書の発行対象：%s"

#: src/Checks/External/TlsCheck.php:192
msgid "The certificate does not match the host name"
msgstr "証明書がホスト名と一致しない"

#: src/Checks/External/TlsCheck.php:192
msgid "Issue a certificate that includes this host name (with and without www if both are used)."
msgstr "このホスト名を含む証明書を発行してください（www あり・なしの両方を使っている場合は両方）。"

#: src/Checks/External/TlsCheck.php:198
msgid "The certificate is self-signed"
msgstr "自己署名証明書"

#: src/Checks/External/TlsCheck.php:198
msgid "The certificate is not trusted"
msgstr "証明書が信頼されていない"

#. translators: %s: error message.
#: src/Checks/External/TlsCheck.php:200
msgid "Certificate verification failed: %s"
msgstr "証明書の検証に失敗しました：%s"

#: src/Checks/External/TlsCheck.php:201
msgid "Use a certificate from a public certificate authority and make sure the intermediate certificates are installed."
msgstr "公的な認証局の証明書を使用し、中間証明書がインストールされていることを確認してください。"

#. translators: %s: protocol such as TLSv1.1.
#: src/Checks/External/TlsCheck.php:207
msgid "The connection used %s, which is no longer considered secure."
msgstr "接続に %s が使われました。このバージョンはもう安全とは見なされていません。"

#: src/Checks/External/TlsCheck.php:208
msgid "An outdated TLS version is used"
msgstr "古い TLS バージョンを使用"

#: src/Checks/External/TlsCheck.php:208
msgid "Enable TLS 1.2 and 1.3 and disable older versions on the server."
msgstr "サーバーで TLS 1.2 と 1.3 を有効にし、それより古いバージョンを無効にしてください。"

#: src/Checks/Files/CodePatternCheck.php:56
msgid "Dangerous code patterns"
msgstr "危険なコードパターン"

#: src/Checks/Files/CodePatternCheck.php:65
msgid "Scans code for eval, shell execution, obfuscation, unsanitized input, unprepared SQL and missing nonce or capability checks."
msgstr "eval、シェルコマンドの実行、難読化、無害化されていない入力、prepare されていない SQL、nonce や権限のチェック漏れがないかコードをスキャンします。"

#: src/Checks/Files/IntegrityCheck.php:42
msgid "File integrity"
msgstr "ファイルの整合性"

#: src/Checks/Files/IntegrityCheck.php:51
msgid "Detects files added, changed or deleted since the approved baseline (sha256)."
msgstr "承認したベースライン以降に追加・変更・削除されたファイルを検出します（sha256）。"

#: src/Checks/Files/IntegrityCheck.php:72
msgid "File could not be read"
msgstr "ファイルを読み取れない"

#: src/Checks/Files/IntegrityCheck.php:73
msgid "The file exists but PHP cannot read it, so changes cannot be detected."
msgstr "ファイルは存在しますが PHP から読み取れないため、変更を検出できません。"

#: src/Checks/Files/IntegrityCheck.php:74
msgid "Check the file permissions."
msgstr "ファイルのパーミッションを確認してください。"

#: src/Checks/Files/IntegrityCheck.php:96
msgid "New file"
msgstr "新しいファイル"

#: src/Checks/Files/IntegrityCheck.php:97
msgid "This file was added after the baseline was approved."
msgstr "このファイルはベースラインの承認後に追加されました。"

#: src/Checks/Files/IntegrityCheck.php:98
msgid "If you deployed this file, approve the current state as the baseline. Otherwise inspect it and remove it if it is not yours."
msgstr "このファイルを自分で配置した場合は、現在の状態をベースラインとして承認してください。そうでない場合は中身を確認し、自分のものでなければ削除してください。"

#: src/Checks/Files/IntegrityCheck.php:116
msgid "File changed"
msgstr "ファイルの変更"

#: src/Checks/Files/IntegrityCheck.php:117
msgid "The contents of this file differ from the approved baseline."
msgstr "このファイルの内容が承認したベースラインと異なります。"

#: src/Checks/Files/IntegrityCheck.php:118
msgid "If the change was a planned deployment, approve the current state as the baseline. Otherwise compare the file with your source and restore it."
msgstr "予定していたデプロイによる変更であれば、現在の状態をベースラインとして承認してください。そうでない場合は、元のソースと比較してファイルを復元してください。"

#: src/Checks/Files/IntegrityCheck.php:159
msgid "File deleted"
msgstr "ファイルの削除"

#: src/Checks/Files/IntegrityCheck.php:160
msgid "This file is in the baseline but no longer exists."
msgstr "このファイルはベースラインに含まれていますが、もう存在しません。"

#: src/Checks/Files/IntegrityCheck.php:161
msgid "If you removed it on purpose, approve the current state as the baseline."
msgstr "意図して削除した場合は、現在の状態をベースラインとして承認してください。"

#: src/Checks/Files/PermissionCheck.php:39
msgid "File permissions"
msgstr "ファイルのパーミッション"

#: src/Checks/Files/PermissionCheck.php:48
msgid "Finds files and directories that every user on the server can write to (e.g. 777, 666)."
msgstr "サーバー上のすべてのユーザーが書き込めるファイルやディレクトリ（例：777、666）を検出します。"

#: src/Checks/Files/PermissionCheck.php:82
#: src/Checks/Files/PermissionCheck.php:130
msgid "World-writable directory"
msgstr "誰でも書き込めるディレクトリ"

#. translators: %s: permissions such as 777.
#: src/Checks/Files/PermissionCheck.php:84
#: src/Checks/Files/PermissionCheck.php:132
msgid "The directory permissions are %s. Any user or process on the server can add files here."
msgstr "ディレクトリのパーミッションは %s です。サーバー上のどのユーザーやプロセスでもここにファイルを追加できます。"

#: src/Checks/Files/PermissionCheck.php:85
#: src/Checks/Files/PermissionCheck.php:133
msgid "Set directories to 755 (or 750) and files to 644 (or 640)."
msgstr "ディレクトリは 755（または 750）、ファイルは 644（または 640）に設定してください。"

#: src/Checks/Files/PermissionCheck.php:108
msgid "World-writable file"
msgstr "誰でも書き込めるファイル"

#. translators: %s: permissions such as 666.
#: src/Checks/Files/PermissionCheck.php:110
msgid "The file permissions are %s. Any user or process on the server can change it."
msgstr "ファイルのパーミッションは %s です。サーバー上のどのユーザーやプロセスでも変更できます。"

#: src/Checks/Files/PermissionCheck.php:111
msgid "Set files to 644 (or 640)."
msgstr "ファイルは 644（または 640）に設定してください。"

#: src/Checks/Files/SuspiciousFileCheck.php:67
msgid "Suspicious files"
msgstr "不審なファイル"

#: src/Checks/Files/SuspiciousFileCheck.php:76
msgid "Finds double extensions, hidden files, PHP files in image or asset folders, PHP code inside images and known web shell names."
msgstr "二重拡張子、隠しファイル、画像やアセットのフォルダ内の PHP ファイル、画像内の PHP コード、既知の Web シェルの名前を検出します。"

#: src/Checks/Files/SuspiciousFileCheck.php:92
msgid "Double file extension"
msgstr "二重拡張子のファイル"

#: src/Checks/Files/SuspiciousFileCheck.php:92
msgid "The file name has two extensions, a trick used to upload executable files disguised as images or documents."
msgstr "ファイル名に拡張子が 2 つあります。画像や文書に見せかけて実行可能ファイルをアップロードする手口です。"

#: src/Checks/Files/SuspiciousFileCheck.php:97
msgid "Hidden PHP file"
msgstr "隠し PHP ファイル"

#: src/Checks/Files/SuspiciousFileCheck.php:97
msgid "A PHP file whose name starts with a dot is hidden from normal directory listings. Backdoors are often stored this way."
msgstr "名前がドットで始まる PHP ファイルは、通常のディレクトリ一覧には表示されません。バックドアはよくこの方法で置かれます。"

#: src/Checks/Files/SuspiciousFileCheck.php:99
msgid ".htaccess inside the directory"
msgstr "ディレクトリ内の .htaccess"

#: src/Checks/Files/SuspiciousFileCheck.php:99
msgid "An .htaccess file can change how the server executes files. Attackers use it to enable PHP in unexpected places or to redirect visitors."
msgstr ".htaccess ファイルを使うと、サーバーがファイルを実行する方法を変更できます。攻撃者は、想定外の場所で PHP を有効にしたり訪問者をリダイレクトしたりするためにこれを利用します。"

#: src/Checks/Files/SuspiciousFileCheck.php:101
msgid "Hidden file"
msgstr "隠しファイル"

#: src/Checks/Files/SuspiciousFileCheck.php:101
msgid "A file whose name starts with a dot was found."
msgstr "名前がドットで始まるファイルが見つかりました。"

#: src/Checks/Files/SuspiciousFileCheck.php:108
msgid "PHP file in an asset folder"
msgstr "アセットフォルダ内の PHP ファイル"

#: src/Checks/Files/SuspiciousFileCheck.php:108
msgid "Image, font and CSS folders should not contain PHP. A PHP file here is often an uploaded backdoor."
msgstr "画像、フォント、CSS のフォルダに PHP ファイルがあるべきではありません。ここにある PHP ファイルは、アップロードされたバックドアであることがよくあります。"

#: src/Checks/Files/SuspiciousFileCheck.php:111
msgid "File name used by web shells"
msgstr "Web シェルで使われるファイル名"

#: src/Checks/Files/SuspiciousFileCheck.php:111
msgid "The file name matches names commonly used by web shells and malware droppers."
msgstr "このファイル名は、Web シェルやマルウェアのドロッパーでよく使われる名前と一致します。"

#: src/Checks/Files/SuspiciousFileCheck.php:114
msgid "Unusual PHP extension"
msgstr "一般的でない PHP の拡張子"

#: src/Checks/Files/SuspiciousFileCheck.php:114
msgid "Extensions such as .phtml, .php5 or .phar are executable on many servers and are used to bypass upload filters."
msgstr ".phtml、.php5、.phar などの拡張子は多くのサーバーで実行可能で、アップロードのフィルターを回避するために使われます。"

#: src/Checks/Files/SuspiciousFileCheck.php:121
msgid "PHP code inside an image"
msgstr "画像内の PHP コード"

#: src/Checks/Files/SuspiciousFileCheck.php:121
msgid "The image file contains PHP code. It may be included by another script to run a backdoor."
msgstr "この画像ファイルには PHP コードが含まれています。別のスクリプトから読み込まれ、バックドアとして実行される可能性があります。"

#: src/Checks/Files/SuspiciousFileCheck.php:147
msgid "Inspect the file. If you do not know why it is there, remove it, check other files changed at the same time and change your passwords."
msgstr "ファイルの中身を確認してください。なぜそこにあるのかわからない場合は削除し、同じ時期に変更された他のファイルも確認して、パスワードを変更してください。"

#: src/Checks/Php/DatabaseVersionCheck.php:39
msgid "Database version"
msgstr "データベースのバージョン"

#: src/Checks/Php/DatabaseVersionCheck.php:57
msgid "Checks whether the MySQL or MariaDB version still receives security updates."
msgstr "MySQL または MariaDB のバージョンがまだセキュリティアップデートを受けられるかチェックします。"

#. translators: 1: MySQL or MariaDB, 2: version.
#: src/Checks/Php/DatabaseVersionCheck.php:109
msgid "%1$s %2$s is no longer supported"
msgstr "%1$s %2$s はサポート終了"

#. translators: %s: date.
#: src/Checks/Php/DatabaseVersionCheck.php:112
msgid "Security support ended on %s."
msgstr "セキュリティサポートは %s に終了しました。"

#: src/Checks/Php/DatabaseVersionCheck.php:113
msgid "Security support has ended."
msgstr "セキュリティサポートは終了しています。"

#: src/Checks/Php/DatabaseVersionCheck.php:114
msgid "Ask your hosting provider to move the database to a supported version."
msgstr "サポートされているバージョンへのデータベースの移行をホスティング会社に依頼してください。"

#. translators: 1: MySQL or MariaDB, 2: version.
#: src/Checks/Php/DatabaseVersionCheck.php:124
msgid "%1$s %2$s support ends soon"
msgstr "%1$s %2$s のサポート終了が間近"

#. translators: 1: date, 2: days.
#: src/Checks/Php/DatabaseVersionCheck.php:126
msgid "Security support ends on %1$s (in %2$d days)."
msgstr "セキュリティサポートは %1$s に終了します（残り %2$d 日）。"

#: src/Checks/Php/DatabaseVersionCheck.php:127
msgid "Plan a database upgrade with your hosting provider."
msgstr "ホスティング会社と相談して、データベースのアップグレードを計画してください。"

#: src/Checks/Php/PhpIniCheck.php:38
msgid "PHP settings"
msgstr "PHP の設定"

#: src/Checks/Php/PhpIniCheck.php:56
msgid "Checks display_errors, expose_php, allow_url_include, allow_url_fopen and similar settings."
msgstr "display_errors、expose_php、allow_url_include、allow_url_fopen などの設定をチェックします。"

#: src/Checks/Php/PhpIniCheck.php:81
msgid "display_errors is on"
msgstr "display_errors が有効"

#: src/Checks/Php/PhpIniCheck.php:81
msgid "PHP errors are shown to visitors. Error messages reveal file paths and code structure."
msgstr "PHP のエラーが訪問者に表示されています。エラーメッセージからファイルのパスやコードの構造が分かってしまいます。"

#: src/Checks/Php/PhpIniCheck.php:81
msgid "Set display_errors = Off and log errors instead (log_errors = On)."
msgstr "display_errors = Off に設定し、代わりにエラーをログに記録してください（log_errors = On）。"

#: src/Checks/Php/PhpIniCheck.php:82
msgid "expose_php is on"
msgstr "expose_php が有効"

#: src/Checks/Php/PhpIniCheck.php:82
msgid "The PHP version is sent in the X-Powered-By header, which helps attackers pick exploits."
msgstr "PHP のバージョンが X-Powered-By ヘッダーで送信されており、攻撃者が攻撃手法を選ぶ手がかりになります。"

#: src/Checks/Php/PhpIniCheck.php:82
msgid "Set expose_php = Off in php.ini (or the hosting control panel)."
msgstr "php.ini（またはホスティングのコントロールパネル）で expose_php = Off に設定してください。"

#: src/Checks/Php/PhpIniCheck.php:83
msgid "allow_url_include is on"
msgstr "allow_url_include が有効"

#: src/Checks/Php/PhpIniCheck.php:83
msgid "include/require can load code from remote URLs, which turns file inclusion bugs into remote code execution."
msgstr "include/require でリモートの URL からコードを読み込めるため、ファイルインクルードの不具合がリモートコード実行につながります。"

#: src/Checks/Php/PhpIniCheck.php:83
msgid "Set allow_url_include = Off."
msgstr "allow_url_include = Off に設定してください。"

#: src/Checks/Php/PhpIniCheck.php:84
msgid "allow_url_fopen is on"
msgstr "allow_url_fopen が有効"

#: src/Checks/Php/PhpIniCheck.php:84
msgid "File functions can open remote URLs. WordPress does not need this (it uses the HTTP API), but some code may rely on it."
msgstr "ファイル関数でリモートの URL を開けます。WordPress 自体には不要です（HTTP API を使用します）が、これに依存するコードがある場合があります。"

#: src/Checks/Php/PhpIniCheck.php:84
msgid "Turn it off if no code on the site depends on it."
msgstr "サイト上にこの設定に依存するコードがなければ無効にしてください。"

#: src/Checks/Php/PhpIniCheck.php:85
msgid "log_errors is off"
msgstr "log_errors が無効"

#: src/Checks/Php/PhpIniCheck.php:85
msgid "PHP errors are not logged, so problems and attacks may go unnoticed."
msgstr "PHP のエラーがログに記録されないため、問題や攻撃に気付けない可能性があります。"

#: src/Checks/Php/PhpIniCheck.php:85
msgid "Set log_errors = On and make sure the log is not publicly accessible."
msgstr "log_errors = On に設定し、ログが外部から閲覧できないことを確認してください。"

#: src/Checks/Php/PhpIniCheck.php:86
msgid "session.cookie_httponly is off"
msgstr "session.cookie_httponly が無効"

#: src/Checks/Php/PhpIniCheck.php:86
msgid "PHP session cookies can be read by JavaScript. WordPress itself does not use PHP sessions, but other code may."
msgstr "PHP のセッション Cookie を JavaScript から読み取れます。WordPress 自体は PHP セッションを使用しませんが、他のコードが使用している場合があります。"

#: src/Checks/Php/PhpIniCheck.php:86
msgid "Set session.cookie_httponly = On."
msgstr "session.cookie_httponly = On に設定してください。"

